# Required: Linear personal API key (Settings → API → Personal API keys).
# Never commit the real value. This file is safe to copy.
LINEAR_API_KEY=

# Optional: pin assignee if viewer/isMe is ambiguous.
LINEAR_USER_ID=

# Optional display name for the env workspace in the switcher.
LINEAR_WORKSPACE_NAME=Default (env)

# Signing secret for POST /api/webhooks/linear.
# The route returns 503 when this is empty. Never commit the real value.
LINEAR_WEBHOOK_SECRET=
